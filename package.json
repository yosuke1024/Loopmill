{
  "name": "loopmill",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first, daemonless workflow runner for subscription-authenticated AI coding agents",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "loopmill": "bin/loopmill.js"
  },
  "files": [
    "bin",
    "dist",
    "docs/spec/*.schema.json",
    "docs/spec/state-machine.json"
  ],
  "scripts": {
    "test": "node --test --test-reporter=spec 'test/**/*.test.ts'",
    "test:watch": "node --test --watch 'test/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "spec:validate": "node docs/spec/validate-examples.mjs && node docs/spec/validate-envelopes.mjs",
    "check": "npm run typecheck && npm test && npm run spec:validate"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2"
  }
}
