      { "id": "R-55", "from": "<any non-terminal>", "event": "<any per-node event>", "guards": ["attemptDoesNotMatchCurrent"],                                    "to": "<unchanged>",             "emits": ["ignored-stale(<stale reason>)"], "actions": [], "result": "ignored-stale" },
