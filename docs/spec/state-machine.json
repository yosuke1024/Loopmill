      { "id": "N-09", "from": ["DISPATCHED", "RUNNING"],                   "event": "node-completed",  "guards": ["structuredOutputValid", "noProgressFires"],              "to": "NO_PROGRESS",             "actions": [] },
      { "id": "N-10", "from": ["DISPATCHED", "RUNNING"],                   "event": "node-completed",  "guards": ["structuredOutputInvalid"],                               "to": "FAILED",                  "failureReason": "schema_invalid", "actions": [] },
      { "id": "N-11", "from": ["DISPATCHED", "RUNNING"],                   "event": "node-failed",     "guards": ["classifiedFailed", "retryable"],                         "to": "DISPATCHED",              "attemptDelta": 1, "actions": ["dispatch"] },
      { "id": "N-12", "from": ["DISPATCHED", "RUNNING"],                   "event": "node-failed",     "guards": ["classifiedFailed", "notRetryable"],                      "to": "FAILED",                  "failureReason": "node_failed", "actions": [] },
