      { "id": "R-21", "from": "RUNNING",           "event": "node-failed",     "guards": ["classifiedFailed", "notRetryable", "onFailureRetryEdge", "iterationBudgetOk"], "to": "RUNNING",         "emits": ["retry-edge-taken(budgetConsumed=true)", "node-dispatched"], "actions": ["dispatch"] },
      { "id": "R-22", "from": "RUNNING",           "event": "node-failed",     "guards": ["classifiedFailed", "notRetryable", "onFailureRetryEdge", "iterationBudgetExhausted"], "to": "MAX_ITERATIONS_EXCEEDED", "emits": ["run-finished(MAX_ITERATIONS_EXCEEDED)"], "actions": ["finish"] },
