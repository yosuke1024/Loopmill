{
  "$comment": "Machine-readable form of docs/spec/state-machine.md. The two files are asserted to agree (invariant I-30). Row ids match the R-/N-/A- ids in section 4 of the specification.",
  "schemaVersion": "1.0.0",
  "spec": "docs/spec/state-machine.md",
  "specVersion": "v0.5",
  "updatedAt": "2026-09-06",

  "policyDefaults": {
    "maxAttempts": 2,
    "maxIterationsRequired": true,
    "maxRuntimeMs": 14400000,
    "maxStepsPerRun": 200,
    "maxQuotaParks": 3,
    "dispatchGraceSeconds": 120,
    "leaseExtensionSeconds": 300,
    "pendingGraceSeconds": 60,
    "quotaJitterSeconds": 60,
    "noProgressStreakLimit": 2,
    "casPushRetries": 5
  },

  "enums": {
    "runState": [
      "PENDING", "RUNNING", "WAITING_HUMAN", "WAITING_FOR_QUOTA", "WAITING_OBSERVED", "INTERRUPTED",
      "SUCCEEDED", "FAILED", "CANCELLED", "MAX_ITERATIONS_EXCEEDED", "BUDGET_EXCEEDED", "EXPIRED", "SKIPPED"
    ],
    "runStateTerminal": [
      "SUCCEEDED", "FAILED", "CANCELLED", "MAX_ITERATIONS_EXCEEDED", "BUDGET_EXCEEDED", "EXPIRED", "SKIPPED"
    ],
    "nodeExecutionState": [
      "PENDING", "DISPATCHED", "RUNNING", "OBSERVING", "WAITING_HUMAN",
      "SUCCEEDED", "FAILED", "TIMED_OUT", "CANCELLED", "SKIPPED", "NO_PROGRESS"
    ],
    "nodeExecutionStateTerminal": [
      "SUCCEEDED", "FAILED", "TIMED_OUT", "CANCELLED", "SKIPPED", "NO_PROGRESS"
    ],
    "attemptState": ["DISPATCHED", "COMPLETED", "FAILED", "LOST"],
    "attemptStateTerminal": ["COMPLETED", "FAILED", "LOST"],
    "classification": ["SUCCESS", "FAILED", "QUOTA", "TIMEOUT", "CANCELLED", "LOST"],
    "failureReason": [
      "node_failed", "node_timed_out", "attempts_exhausted", "dispatch_failed", "artifact_invalid",
      "observe_deadline", "condition_error", "schema_invalid", "no_progress_stalled",
      "quota_unclassifiable", "quota_parks_exhausted", "human_rejected", "interrupted_abandoned",
      "validation_error"
    ],
    "budgetKey": ["maxMeasuredTokens", "maxUnmeasuredExecutions", "maxStepsPerRun"],
    "expiryReason": ["max_runtime", "human_timeout"],
    "skipReason": ["dedupe", "min_interval", "runs_per_window"],
    "cancelledBy": ["human", "platform", "timeout-escalation"],
    "staleReason": [
      "duplicate_event_id", "semantic_duplicate", "run_terminal", "run_not_started",
      "run_already_started", "unknown_node", "stale_cycle", "future_cycle", "stale_attempt",
      "future_attempt", "no_attempt_in_flight", "node_terminal", "approval_subject_mismatch",
      "not_due", "lease_not_expired", "wrong_wait_state", "producer_not_expected", "unknown_event_type"
    ],
    "transitionResultKind": ["applied", "duplicate", "ignored-stale", "invalid"],
    "actionType": ["dispatch", "request-approval", "observe", "wait", "finish"],
    "producer": ["control-plane", "backend:<id>", "human", "trigger"],
    "gateMode": ["cli", "pull-request-review", "label"],
    "matcherKind": ["comment-block", "file-in-diff", "cloud-status"],
    "matcherOutcome": ["found_valid", "found_invalid"],
    "onFailure": ["fail_run", "continue", "retry_edge:<edgeId>"],
    "onInterrupted": ["retry", "ask"],
    "$comment_onInterrupted": "Derived by the engine from node.effects (none -> retry, external -> ask); not a loop file field (D-11).",
    "resumeKind": ["due", "manual", "interrupted"],
    "resumeDecision": ["retry", "skip", "fail"],
    "leaseExpiredReason": ["attempt_deadline", "control_plane_lease", "observe_deadline"],
    "timeoutCode": ["node_timeout", "observe_deadline", "human_timeout"],
    "usageProvenance": ["reported", "derived", "estimated", "unavailable"]
  },

  "events": [
    { "eventType": "run-requested",    "producers": ["trigger", "control-plane"], "inbound": true,  "emitted": false, "requires": ["trigger"],                                              "drives": ["run"] },
    { "eventType": "run-started",      "producers": ["control-plane"],            "inbound": false, "emitted": true,  "requires": [],                                                       "drives": ["run"] },
    { "eventType": "node-dispatched",  "producers": ["control-plane"],            "inbound": false, "emitted": true,  "requires": ["cycle", "nodeId", "attempt", "dispatch{backendId,transport,expectedProducer}"],               "drives": ["run", "nodeExecution", "attempt"] },
    { "eventType": "node-started",     "producers": ["backend:<id>"],             "inbound": true,  "emitted": false, "requires": ["cycle", "nodeId", "attempt"],                           "drives": ["nodeExecution", "attempt"] },
    { "eventType": "node-completed",   "producers": ["backend:<id>", "control-plane"], "inbound": true, "emitted": true, "requires": ["cycle", "nodeId", "attempt", "result.status in [succeeded, skipped, no_progress]"], "drives": ["run", "nodeExecution", "attempt"] },
    { "eventType": "node-failed",      "producers": ["backend:<id>", "control-plane"], "inbound": true, "emitted": true, "requires": ["cycle", "nodeId", "attempt", "result.status", "error"], "drives": ["run", "nodeExecution", "attempt"] },
    { "eventType": "node-timed-out",   "producers": ["backend:<id>", "control-plane"], "inbound": true, "emitted": true, "requires": ["cycle", "nodeId", "attempt", "error.code"],                      "drives": ["run", "nodeExecution", "attempt"] },
    { "eventType": "node-observed",    "producers": ["backend:observed"],         "inbound": true,  "emitted": false, "requires": ["cycle", "nodeId", "attempt", "matcher{kind,ref,outcome}", "artifactRefs"],                "drives": ["run", "nodeExecution", "attempt"] },
    { "eventType": "human-requested",  "producers": ["control-plane"],            "inbound": false, "emitted": true,  "requires": ["cycle", "nodeId", "attempt", "human{mode,subjectDigest}"],                   "drives": ["run", "nodeExecution"] },
    { "eventType": "human-decided",    "producers": ["human"],                    "inbound": true,  "emitted": false, "requires": ["cycle", "nodeId", "attempt", "human.decision", "human.subjectDigest"], "drives": ["run", "nodeExecution"] },
    { "eventType": "quota-parked",     "producers": ["control-plane"],            "inbound": false, "emitted": true,  "requires": ["cycle", "nodeId", "attempt", "quotaResetsAt", "reason"],                  "drives": ["run"] },
    { "eventType": "retry-edge-taken", "producers": ["control-plane"],            "inbound": false, "emitted": true,  "requires": ["cycle", "retryEdge{edgeId,fromNodeId,toNodeId,fromCycle,toCycle,maxIterations,traversals,budgetConsumed}"], "drives": ["run"] },
    { "eventType": "run-finished",     "producers": ["control-plane"],            "inbound": false, "emitted": true,  "requires": ["outcome"],                   "drives": ["run"] },
    { "eventType": "ignored-stale",    "producers": ["control-plane"],            "inbound": false, "emitted": true,  "requires": ["reason", "causationId"],                                    "drives": [] },
    { "eventType": "dispatch-failed",  "producers": ["control-plane"],            "inbound": false, "emitted": true,  "requires": ["cycle", "nodeId", "attempt", "dispatch", "error"],                  "drives": ["run", "nodeExecution", "attempt"] },
    { "eventType": "resumed",          "producers": ["human", "control-plane"],   "inbound": true,  "emitted": false, "requires": ["resume.kind", "reason"],                                          "drives": ["run"] },
    { "eventType": "lease-expired",    "producers": ["control-plane"],            "inbound": true,  "emitted": true,  "requires": ["cycle", "nodeId", "attempt", "reason"],                 "drives": ["run", "nodeExecution", "attempt"] }
  ],

  "guards": {
    "envelopeValid": "schema valid, producer allowed for eventType, loopId/loopVersion match the pinned run",
    "loopValidates": "the pinned loop file passes `loopmill validate`",
    "notDeduped": "no open change exists for trigger.dedupeKey",
    "withinRateLimits": "minInterval and maxRunsPerWindow satisfied for the Loop",
    "preDispatchOk": "preDispatch(node, cycleIndex, edge?) returns ok (ordered check, spec 11.2)",
    "preDispatchBreach": "preDispatch returns a terminal Outcome",
    "entryDispatchable": "the loop's entry node is neither a human node nor an observed-backend node",
    "nodeIsHuman": "target node kind == 'human'",
    "backendObserved": "target node's backend capability result == 'observed'",
    "routeNext": "route(node, result) == next(nodeId)",
    "routeEnd": "route(node, result) == end(label)",
    "routeRetryEdge": "route(node, result) == retryEdge(edgeId)",
    "iterationBudgetOk": "traversals[edgeId] < maxIterations[edgeId]",
    "iterationBudgetExhausted": "traversals[edgeId] >= maxIterations[edgeId]",
    "freeTraversalBudgetExhausted": "freeTraversals[edgeId] >= maxIterations[edgeId]",
    "noProgressFires": "the NO_PROGRESS rule of spec 6.6 holds for this node execution",
    "noProgressStreakBelowLimit": "noProgressStreak after this event < 2",
    "noProgressStreakAtLimit": "noProgressStreak after this event >= 2",
    "retryable": "chargedAttempts[cycle:nodeId] < node.maxAttempts AND backend.retryable == true",
    "notRetryable": "NOT retryable",
    "classifiedFailed": "classifyFailure verdict is FAILED (any error.classified outside quota/timeout/cancelled, or quota without quotaResetsAt)",
    "classifiedQuota": "classifyFailure verdict is QUOTA (error.classified == 'quota' with quotaResetsAt)",
    "classifiedCancelled": "classifyFailure verdict is CANCELLED (error.classified == 'cancelled')",
    "quotaResolvable": "quotaResetsAt is reported or derivable from the runtime's documented window",
    "quotaUnresolvable": "NOT quotaResolvable",
    "quotaParksAvailable": "quota.parks < policy.maxQuotaParks",
    "quotaParksExhausted": "quota.parks >= policy.maxQuotaParks",
    "structuredOutputValid": "the node declares no structuredOutput, or it does and the parsed result validates against it. An observed node can never declare one (LM-VAL-018), so its artifact is judged by matcher.outcome alone.",
    "structuredOutputInvalid": "NOT structuredOutputValid",
    "onFailureFailRun": "node.onFailure == 'fail_run'",
    "onFailureContinue": "node.onFailure == 'continue'",
    "onFailureRetryEdge": "node.onFailure == 'retry_edge:<edgeId>'",
    "onInterruptedRetry": "derived interruption policy is retry (node.effects == 'none')",
    "onInterruptedAsk": "derived interruption policy is ask (node.effects == 'external')",
    "effectsNone": "node.effects == 'none'",
    "effectsExternal": "node.effects == 'external'",
    "digestMatches": "event.subjectDigest == snapshot.pendingApproval.subject.digest",
    "digestMismatch": "NOT digestMatches",
    "decisionApprove": "event.decision == 'approve'",
    "decisionReject": "event.decision == 'reject'",
    "decisionCancel": "event.decision == 'cancel'",
    "rejectOnFailureFailRun": "node.onFailure == 'fail_run' (a rejected gate is routed by onFailure, D-02)",
    "rejectOnFailureRetryEdge": "node.onFailure == 'retry_edge:<edgeId>' (a rejected gate is routed by onFailure, D-02)",
    "gateExpired": "ctx.now >= snapshot.pendingApproval.expiresAt",
    "resumeDue": "resume.kind == 'due' AND ctx.now >= snapshot.quota.resumeDueAt",
    "resumeNotDue": "resume.kind == 'due' AND ctx.now < snapshot.quota.resumeDueAt",
    "resumeManual": "resume.kind == 'manual'",
    "resumeDecisionRetry": "resume.decision == 'retry'",
    "resumeDecisionSkip": "resume.decision == 'skip'",
    "resumeDecisionFail": "resume.decision == 'fail'",
    "matcherFoundValid": "matcher.outcome == 'found_valid'",
    "matcherFoundInvalid": "matcher.outcome == 'found_invalid'",
    "timeoutCodeNode": "error.code == 'node_timeout'",
    "timeoutCodeObserve": "error.code == 'observe_deadline'",
    "timeoutCodeHuman": "error.code == 'human_timeout'",
    "controlPlaneLocal": "producer == 'control-plane' AND attempt == 0 (condition, end, synthetic)",
    "attemptMatchesCurrent": "(cycle, nodeId, attempt) == snapshot.current",
    "attemptDoesNotMatchCurrent": "NOT attemptMatchesCurrent",
    "eventIdSeen": "event.eventId is in appliedEventIds, ignoredEventIds or emittedEventIds",
    "producerNotAllowed": "producer is not in the allowlist for this eventType",
    "leaseExpired": "snapshot.lease != null AND ctx.now >= snapshot.lease.expiresAt"
  },

  "preDispatchOrder": [
    { "step": 1, "check": "traversals[edgeId] >= maxIterations[edgeId]",              "outcome": "MAX_ITERATIONS_EXCEEDED" },
    { "step": 2, "check": "freeTraversals[edgeId] >= maxIterations[edgeId]",          "outcome": "MAX_ITERATIONS_EXCEEDED" },
    { "step": 3, "check": "budget.measuredTokens >= budget.maxMeasuredTokens",        "outcome": "BUDGET_EXCEEDED(maxMeasuredTokens)" },
    { "step": 4, "check": "budget.unmeasuredExecutions >= budget.maxUnmeasuredExecutions", "outcome": "BUDGET_EXCEEDED(maxUnmeasuredExecutions)" },
    { "step": 5, "check": "budget.activeMs >= budget.maxRuntime",                     "outcome": "EXPIRED(max_runtime)" },
    { "step": 6, "check": "budget.stepsUsed >= policy.maxStepsPerRun",                "outcome": "BUDGET_EXCEEDED(maxStepsPerRun)" },
    { "step": 7, "check": "otherwise",                                                "outcome": "ok" }
  ],

  "classifyFailureOrder": [
    { "order": 1, "result": "LOST",      "condition": "deadlineMissed (sweep only)" },
    { "order": 2, "result": "TIMEOUT",   "condition": "timeoutFired, or error.code in [node_timeout, observe_deadline, human_timeout]" },
    { "order": 3, "result": "CANCELLED", "condition": "cancelRequested and the process ended, or the backend reports a job cancel" },
    { "order": 4, "result": "QUOTA",     "condition": "positive quota pattern match AND no retryable look-alike match" },
    { "order": 5, "result": "SUCCESS",   "condition": "exit 0 AND well-formed terminal result AND structured output validates when declared" },
    { "order": 6, "result": "FAILED",    "condition": "everything else (the ambiguity rule)" }
  ],

  "quotaPatterns": {
    "claude-code": {
      "positive": [
        "/You've hit your (session|weekly|Opus|Sonnet|Fable|usage credit) limit/",
        "stream event system/api_retry with error 'rate_limit' or 'billing_error' (leading indicator only)"
      ],
      "negative": [
        "Server is temporarily limiting requests",
        "Request rejected (429)"
      ],
      "resetSuffix": "· resets at <time>",
      "derivedWindowSeconds": { "session limit": 18000, "weekly limit": 604800, "Opus limit": 604800, "Sonnet limit": 604800, "Fable limit": 604800 }
    },
    "codex": {
      "positive": [
        "case-insensitive substring 'usage limit' in turn.failed.error.message or error.message",
        "app-server codexErrorInfo == 'usageLimitExceeded'"
      ],
      "negative": ["rate_limit_exceeded with willRetry true"],
      "resetSource": "app-server RateLimitWindow.resetsAt (epoch seconds) and windowDurationMins",
      "derivedWindowSeconds": { "primary": 18000, "secondary": 604800 }
    }
  },

  "exitCodes": {
    "loopmill step": {
      "0": "handled: applied, duplicate, or ignored-stale",
      "1": "unexpected error",
      "2": "invalid envelope or invalid loop file",
      "3": "state conflict not resolved after CAS retries",
      "4": "backend dispatch failed (state records dispatch-failed)"
    },
    "loopmill run (local)": {
      "0": "Run SUCCEEDED",
      "1": "unexpected error",
      "2": "invalid loop file or trigger input",
      "3": "state conflict not resolved",
      "4": "backend dispatch failed",
      "10": "Run FAILED",
      "11": "Run MAX_ITERATIONS_EXCEEDED",
      "12": "Run BUDGET_EXCEEDED",
      "13": "Run EXPIRED",
      "14": "Run CANCELLED",
      "15": "Run SKIPPED",
      "20": "exited in WAITING_HUMAN",
      "21": "exited in WAITING_FOR_QUOTA",
      "22": "exited in WAITING_OBSERVED",
      "23": "exited in INTERRUPTED"
    }
  },

  "jobSummaryMapping": [
    { "runState": "SUCCEEDED",               "headline": "Succeeded — <label>",                                    "conclusion": "success" },
    { "runState": "FAILED",                  "headline": "Failed — <failureReason> at <nodeId> (cycle <n>)",        "conclusion": "failure" },
    { "runState": "MAX_ITERATIONS_EXCEEDED", "headline": "Loop budget exhausted — <edgeId>, <traversals>/<max>",    "conclusion": "neutral" },
    { "runState": "BUDGET_EXCEEDED",         "headline": "Budget exceeded — <budgetKey> (<observed>/<limit>)",      "conclusion": "neutral" },
    { "runState": "EXPIRED",                 "headline": "Expired — <expiryReason>",                                "conclusion": "neutral" },
    { "runState": "CANCELLED",               "headline": "Cancelled — by <by>",                                     "conclusion": "cancelled" },
    { "runState": "SKIPPED",                 "headline": "Skipped — <skipReason>",                                  "conclusion": "neutral" }
  ],

  "machines": {
    "run": {
      "initial": "PENDING",
      "states": {
        "PENDING":                 { "terminal": false, "holdsLease": false, "clock": "active",  "definition": "Run record exists, loopVersion pinned, dedupe and rate checks passed; no node selected yet." },
        "RUNNING":                 { "terminal": false, "holdsLease": true,  "clock": "active",  "definition": "Exactly one node execution is PENDING/DISPATCHED/RUNNING; the attempt lease is held." },
        "WAITING_HUMAN":           { "terminal": false, "holdsLease": false, "clock": "wait",    "definition": "A human node awaits a decision; no lease; maxRuntime paused." },
        "WAITING_FOR_QUOTA":       { "terminal": false, "holdsLease": false, "clock": "wait",    "definition": "Last attempt classified QUOTA with a quotaResetsAt; parked until resumeDueAt." },
        "WAITING_OBSERVED":        { "terminal": false, "holdsLease": true,  "clock": "active",  "definition": "An observed-backend node was triggered; the artifact matcher runs until a deadline." },
        "INTERRUPTED":             { "terminal": false, "holdsLease": false, "clock": "wait",    "definition": "The attempt lease expired and the node cannot be safely auto-re-dispatched." },
        "SUCCEEDED":               { "terminal": true,  "outcome": "SUCCEEDED(end:<label>)",             "definition": "The Run reached an end node." },
        "FAILED":                  { "terminal": true,  "outcome": "FAILED(<failureReason>)",            "definition": "A node failure propagated under onFailure: fail_run, or the loop stalled." },
        "CANCELLED":               { "terminal": true,  "outcome": "CANCELLED(<by>)",                    "definition": "A human or the platform cancelled the Run or its in-flight job." },
        "MAX_ITERATIONS_EXCEEDED": { "terminal": true,  "outcome": "MAX_ITERATIONS_EXCEEDED(<edgeId>,<traversals>/<max>)", "definition": "A Retry Edge would have been traversed beyond maxIterations. Never FAILED." },
        "BUDGET_EXCEEDED":         { "terminal": true,  "outcome": "BUDGET_EXCEEDED(<budgetKey>)",       "definition": "A pre-dispatch budget check breached." },
        "EXPIRED":                 { "terminal": true,  "outcome": "EXPIRED(<expiryReason>)",            "definition": "maxRuntime elapsed, or a human gate passed its timeout." },
        "SKIPPED":                 { "terminal": true,  "outcome": "SKIPPED(<skipReason>)",              "definition": "Refused at request time: dedupe hit, or the Loop's rate limits forbid starting." }
      }
    },
    "nodeExecution": {
      "initial": "PENDING",
      "states": {
        "PENDING":       { "terminal": false, "definition": "Selected for this cycle (or un-parked from quota); no node-dispatched recorded for the pending attempt." },
        "DISPATCHED":    { "terminal": false, "definition": "node-dispatched recorded; an Attempt is DISPATCHED." },
        "RUNNING":       { "terminal": false, "definition": "node-started received; only streaming backends produce this." },
        "OBSERVING":     { "terminal": false, "definition": "An observed backend was triggered; the matcher runs until observeDeadlineAt." },
        "WAITING_HUMAN": { "terminal": false, "definition": "human-requested recorded, awaiting human-decided." },
        "SUCCEEDED":     { "terminal": true,  "definition": "Produced a valid result, including a negative verdict." },
        "FAILED":        { "terminal": true,  "definition": "Attempts exhausted with a FAILED classification, or a matcher/schema rejection." },
        "TIMED_OUT":     { "terminal": true,  "definition": "The node timeout, observe deadline, or human gate timeout elapsed." },
        "CANCELLED":     { "terminal": true,  "definition": "The attempt was cancelled." },
        "SKIPPED":       { "terminal": true,  "definition": "Not executed: onFailure continue, resume --decision skip, or an untaken branch record." },
        "NO_PROGRESS":   { "terminal": true,  "definition": "An agent node in a Retry Edge body produced a change-set byte-identical to its own previous cycle. Does not consume the iteration budget." }
      }
    },
    "attempt": {
      "initial": "DISPATCHED",
      "states": {
        "DISPATCHED": { "terminal": false, "definition": "node-dispatched recorded; owns the lease until deadlineAt." },
        "COMPLETED":  { "terminal": true,  "definition": "Terminal report with classification SUCCESS." },
        "FAILED":     { "terminal": true,  "definition": "Terminal report with classification FAILED, QUOTA, TIMEOUT or CANCELLED (classification is a field, not a state)." },
        "LOST":       { "terminal": true,  "definition": "No completion by deadlineAt; the sweep declared it lost." }
      }
    }
  },

  "transitions": {
    "run": [
      { "id": "R-01", "from": null,                "event": "run-requested",   "guards": ["envelopeValid", "loopValidates", "notDeduped", "withinRateLimits"], "to": "PENDING",                 "emits": ["run-started"], "actions": [] },
      { "id": "R-02", "from": null,                "event": "run-requested",   "guards": ["NOT notDeduped"],                                                     "to": "SKIPPED",                 "emits": ["run-finished(SKIPPED,dedupe)"], "actions": ["finish"] },
      { "id": "R-03", "from": null,                "event": "run-requested",   "guards": ["NOT withinRateLimits"],                                               "to": "SKIPPED",                 "emits": ["run-finished(SKIPPED,min_interval|runs_per_window)"], "actions": ["finish"] },
      { "id": "R-04", "from": null,                "event": "run-requested",   "guards": ["NOT loopValidates"],                                                  "to": null,                      "emits": [], "actions": [], "result": "invalid", "exitCode": 2 },
      { "id": "R-05", "from": "PENDING",           "event": "run-started",     "guards": ["entryDispatchable", "preDispatchOk"],                                 "to": "RUNNING",                 "emits": ["node-dispatched"], "actions": ["dispatch"] },
      { "id": "R-06", "from": "PENDING",           "event": "run-started",     "guards": ["nodeIsHuman"],                                                        "to": "WAITING_HUMAN",           "emits": ["human-requested"], "actions": ["request-approval"] },
      { "id": "R-07", "from": "PENDING",           "event": "run-started",     "guards": ["backendObserved", "preDispatchOk"],                                   "to": "WAITING_OBSERVED",        "emits": ["node-dispatched"], "actions": ["observe"] },
      { "id": "R-08", "from": "PENDING",           "event": "run-started",     "guards": ["preDispatchBreach"],                                                  "to": "<outcome.state>",         "emits": ["run-finished"], "actions": ["finish"] },
      { "id": "R-09", "from": "RUNNING",           "event": "node-completed",  "guards": ["routeNext", "preDispatchOk", "NOT nodeIsHuman", "NOT backendObserved"], "to": "RUNNING",                "emits": ["node-dispatched"], "actions": ["dispatch"] },
      { "id": "R-10", "from": "RUNNING",           "event": "node-completed",  "guards": ["routeNext", "nodeIsHuman"],                                           "to": "WAITING_HUMAN",           "emits": ["human-requested"], "actions": ["request-approval"] },
      { "id": "R-11", "from": "RUNNING",           "event": "node-completed",  "guards": ["routeNext", "backendObserved", "preDispatchOk"],                      "to": "WAITING_OBSERVED",        "emits": ["node-dispatched"], "actions": ["observe"] },
      { "id": "R-12", "from": "RUNNING",           "event": "node-completed",  "guards": ["routeEnd"],                                                           "to": "SUCCEEDED",               "emits": ["run-finished(SUCCEEDED,<label>)"], "actions": ["finish"] },
      { "id": "R-13", "from": "RUNNING",           "event": "node-completed",  "guards": ["routeRetryEdge", "iterationBudgetOk", "preDispatchOk"],               "to": "RUNNING",                 "emits": ["retry-edge-taken(budgetConsumed=true)", "node-dispatched"], "actions": ["dispatch"] },
      { "id": "R-14", "from": "RUNNING",           "event": "node-completed",  "guards": ["routeRetryEdge", "iterationBudgetExhausted"],                         "to": "MAX_ITERATIONS_EXCEEDED", "emits": ["run-finished(MAX_ITERATIONS_EXCEEDED)"], "actions": ["finish"] },
      { "id": "R-15", "from": "RUNNING",           "event": "node-completed",  "guards": ["noProgressFires", "noProgressStreakBelowLimit", "NOT freeTraversalBudgetExhausted"], "to": "RUNNING",   "emits": ["retry-edge-taken(budgetConsumed=false)", "node-dispatched"], "actions": ["dispatch"] },
