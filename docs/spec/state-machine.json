      { "id": "R-18", "from": "RUNNING",           "event": "node-failed",     "guards": ["classifiedFailed", "retryable"],                                      "to": "RUNNING",                 "emits": ["node-dispatched(attempt+1)"], "actions": ["dispatch"] },
