      { "id": "R-25", "from": "RUNNING",           "event": "node-failed",     "guards": ["classifiedQuota", "quotaParksExhausted"],                             "to": "FAILED",                  "emits": ["run-finished(FAILED,quota_parks_exhausted)"], "actions": ["finish"] },
      { "id": "R-26", "from": "RUNNING",           "event": "node-failed",     "guards": ["classifiedCancelled"],                                                "to": "CANCELLED",               "emits": ["run-finished(CANCELLED,platform)"], "actions": ["finish"] },
      { "id": "R-27", "from": "RUNNING",           "event": "node-timed-out",  "guards": ["timeoutCodeNode", "retryable", "effectsNone"],                        "to": "RUNNING",                 "emits": ["node-dispatched(attempt+1)"], "actions": ["dispatch"] },
      { "id": "R-28", "from": "RUNNING",           "event": "node-timed-out",  "guards": ["timeoutCodeNode", "onFailureFailRun"],                                "to": "FAILED",                  "emits": ["run-finished(FAILED,node_timed_out)"], "actions": ["finish"] },
      { "id": "R-29", "from": "RUNNING",           "event": "dispatch-failed", "guards": ["retryable"],                                                          "to": "RUNNING",                 "emits": ["node-dispatched(attempt+1)"], "actions": ["dispatch"] },
      { "id": "R-30", "from": "RUNNING",           "event": "dispatch-failed", "guards": ["notRetryable"],                                                       "to": "FAILED",                  "emits": ["run-finished(FAILED,dispatch_failed)"], "actions": ["finish"] },
      { "id": "R-31", "from": "RUNNING",           "event": "lease-expired",   "guards": ["onInterruptedRetry", "retryable"],                                    "to": "RUNNING",                 "emits": ["node-dispatched(attempt+1)"], "actions": ["dispatch"] },
      { "id": "R-32", "from": "RUNNING",           "event": "lease-expired",   "guards": ["onInterruptedAsk OR (notRetryable AND effectsExternal)"],             "to": "INTERRUPTED",             "emits": [], "actions": ["wait"] },
      { "id": "R-33", "from": "RUNNING",           "event": "lease-expired",   "guards": ["notRetryable", "effectsNone", "onFailureFailRun"],                    "to": "FAILED",                  "emits": ["run-finished(FAILED,attempts_exhausted)"], "actions": ["finish"] },
      { "id": "R-34", "from": "WAITING_HUMAN",     "event": "human-decided",   "guards": ["decisionApprove", "digestMatches", "routeNext", "preDispatchOk"],      "to": "RUNNING",                 "emits": ["node-completed(control-plane)", "node-dispatched"], "actions": ["dispatch"] },
      { "id": "R-35", "from": "WAITING_HUMAN",     "event": "human-decided",   "guards": ["decisionReject", "digestMatches", "rejectOnFailureFailRun"],                 "to": "FAILED",                  "emits": ["node-completed(control-plane)", "run-finished(FAILED,human_rejected)"], "actions": ["finish"] },
      { "id": "R-36", "from": "WAITING_HUMAN",     "event": "human-decided",   "guards": ["decisionReject", "digestMatches", "rejectOnFailureRetryEdge", "iterationBudgetOk"], "to": "RUNNING",           "emits": ["node-completed(control-plane)", "retry-edge-taken(budgetConsumed=true)", "node-dispatched"], "actions": ["dispatch"] },
      { "id": "R-37", "from": "WAITING_HUMAN",     "event": "human-decided",   "guards": ["decisionCancel", "digestMatches"],                                    "to": "CANCELLED",               "emits": ["node-completed(CANCELLED)", "run-finished(CANCELLED,human)"], "actions": ["finish"] },
      { "id": "R-38", "from": "WAITING_HUMAN",     "event": "human-decided",   "guards": ["digestMismatch"],                                                     "to": "WAITING_HUMAN",           "emits": ["ignored-stale(approval_subject_mismatch)"], "actions": [], "result": "ignored-stale" },
      { "id": "R-39", "from": "WAITING_HUMAN",     "event": "node-timed-out",  "guards": ["timeoutCodeHuman", "gateExpired"],                                    "to": "EXPIRED",                 "emits": ["run-finished(EXPIRED,human_timeout)"], "actions": ["finish"] },
      { "id": "R-40", "from": "WAITING_FOR_QUOTA", "event": "resumed",         "guards": ["resumeDue", "preDispatchOk"],                                         "to": "RUNNING",                 "emits": ["node-dispatched(attempt+1)"], "actions": ["dispatch"] },
      { "id": "R-41", "from": "WAITING_FOR_QUOTA", "event": "resumed",         "guards": ["resumeManual", "preDispatchOk"],                                      "to": "RUNNING",                 "emits": ["node-dispatched(attempt+1)"], "actions": ["dispatch"] },
