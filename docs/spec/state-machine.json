      { "id": "R-43", "from": "WAITING_OBSERVED",  "event": "node-observed",   "guards": ["matcherFoundValid"],                                                  "to": "<R-09..R-17 fan-out>",    "emits": ["<per fan-out>"], "actions": ["<per fan-out>"] },
      { "id": "R-44", "from": "WAITING_OBSERVED",  "event": "node-observed",   "guards": ["matcherFoundInvalid", "retryable"],                                   "to": "WAITING_OBSERVED",        "emits": ["node-dispatched(attempt+1)"], "actions": ["observe"] },
      { "id": "R-45", "from": "WAITING_OBSERVED",  "event": "node-observed",   "guards": ["matcherFoundInvalid", "notRetryable", "onFailureFailRun"],            "to": "FAILED",                  "emits": ["run-finished(FAILED,artifact_invalid)"], "actions": ["finish"] },
      { "id": "R-46", "from": "WAITING_OBSERVED",  "event": "node-timed-out",  "guards": ["timeoutCodeObserve", "retryable"],                                    "to": "WAITING_OBSERVED",        "emits": ["node-dispatched(attempt+1)"], "actions": ["observe"] },
      { "id": "R-47", "from": "WAITING_OBSERVED",  "event": "node-timed-out",  "guards": ["timeoutCodeObserve", "notRetryable", "onFailureFailRun"],             "to": "FAILED",                  "emits": ["run-finished(FAILED,observe_deadline)"], "actions": ["finish"] },
      { "id": "R-48", "from": "INTERRUPTED",       "event": "resumed",         "guards": ["resumeDecisionRetry", "preDispatchOk"],                               "to": "RUNNING",                 "emits": ["node-dispatched(attempt+1)"], "actions": ["dispatch"] },
      { "id": "R-49", "from": "INTERRUPTED",       "event": "resumed",         "guards": ["resumeDecisionSkip", "routeNext"],                                    "to": "RUNNING",                 "emits": ["node-completed(SKIPPED,control-plane)", "node-dispatched"], "actions": ["dispatch"] },
      { "id": "R-50", "from": "INTERRUPTED",       "event": "resumed",         "guards": ["resumeDecisionFail"],                                                 "to": "FAILED",                  "emits": ["run-finished(FAILED,interrupted_abandoned)"], "actions": ["finish"] },
