    "attempt": [
      { "id": "A-01", "from": null,             "event": "node-dispatched", "guards": ["attempt >= 1"],                                     "to": "DISPATCHED", "records": ["backendId", "runtimeId", "authMode", "dispatchedAt", "deadlineAt", "dedupeKey"] },
