      { "id": "A-04", "from": "DISPATCHED",     "event": "node-observed",   "guards": ["attemptMatchesCurrent", "matcherFoundValid"],       "to": "COMPLETED",  "classification": "SUCCESS", "records": ["usage.provenance=unavailable", "artifactRefs"] },
      { "id": "A-05", "from": "DISPATCHED",     "event": "node-observed",   "guards": ["attemptMatchesCurrent", "matcherFoundInvalid"],     "to": "FAILED",     "classification": "FAILED",  "records": ["error.code=artifact_invalid"] },
      { "id": "A-06", "from": "DISPATCHED",     "event": "node-failed",     "guards": ["attemptMatchesCurrent"],                            "to": "FAILED",     "classification": "FAILED|QUOTA|CANCELLED", "records": ["error", "usage if present"] },
      { "id": "A-07", "from": "DISPATCHED",     "event": "node-timed-out",  "guards": ["attemptMatchesCurrent"],                            "to": "FAILED",     "classification": "TIMEOUT", "records": ["usage.provenance=unavailable"] },
      { "id": "A-08", "from": "DISPATCHED",     "event": "dispatch-failed", "guards": ["attemptMatchesCurrent"],                            "to": "FAILED",     "classification": "FAILED",  "records": ["error.code=dispatch_failed"] },
      { "id": "A-09", "from": "DISPATCHED",     "event": "lease-expired",   "guards": ["attemptMatchesCurrent", "leaseExpired"],            "to": "LOST",       "classification": "LOST",    "records": ["usage.provenance=unavailable", "complete=false"] },
      { "id": "A-10", "from": "<any terminal>", "event": "<any control event>", "guards": [],                                                "to": "<unchanged>", "emits": ["ignored-stale(stale_attempt)"], "result": "ignored-stale" },
      { "id": "A-11", "from": "<any terminal>", "event": "<any event carrying usage for this attempt>", "guards": ["the attempt has no usage record yet"], "to": "<unchanged>", "records": ["usage appended to the ledger only"], "result": "ignored-stale", "note": "the single permitted non-control effect of an ignored-stale event (spec 5.4, D-20)" }
    ]
