      { "id": "R-52", "from": "PENDING",           "event": "<any except run-started, run-finished>", "guards": [],                                              "to": "<unchanged>",             "emits": ["ignored-stale(run_not_started)"], "actions": [], "result": "ignored-stale" },
      { "id": "R-53", "from": "<any terminal>",    "event": "<any>",           "guards": ["NOT eventIdSeen"],                                                    "to": "<unchanged>",             "emits": ["ignored-stale(run_terminal)"], "actions": [], "result": "ignored-stale" },
