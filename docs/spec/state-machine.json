      { "id": "N-31", "from": null,                                        "event": "<any except node-dispatched, human-requested, control-plane node-completed>", "guards": [], "to": "<unchanged>",       "emits": ["ignored-stale(no_attempt_in_flight)"], "actions": [], "result": "ignored-stale" }
