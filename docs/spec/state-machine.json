      { "id": "N-16", "from": ["DISPATCHED", "RUNNING"],                   "event": "node-timed-out",  "guards": ["timeoutCodeNode", "retryable", "effectsNone"],           "to": "DISPATCHED",              "attemptDelta": 1, "actions": ["dispatch"] },
