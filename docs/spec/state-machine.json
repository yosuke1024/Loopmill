      { "id": "N-18", "from": ["DISPATCHED", "RUNNING", "OBSERVING"],      "event": "lease-expired",   "guards": ["notRetryable", "effectsNone"],                           "to": "FAILED",                  "failureReason": "attempts_exhausted", "actions": [] },
      { "id": "N-19", "from": ["DISPATCHED", "RUNNING", "OBSERVING"],      "event": "lease-expired",   "guards": ["onInterruptedAsk"],                                      "to": "<unchanged, frozen>",     "actions": [], "runEffect": "INTERRUPTED" },
